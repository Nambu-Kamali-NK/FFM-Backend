        "title": "AC Equipment Specifications",
        "description": "Technical parameters captured dynamically",
        "fields": [
          { "key": "acBrand", "label": "AC Manufacturer / Brand", "widget": "DROPDOWN", "required": true, "options": ["Daikin", "Voltas", "Blue Star", "Carrier", "Hitachi", "LG", "Other"] },
          { "key": "acTonnage", "label": "Cooling Capacity (Tonnage)", "widget": "NUMBER_INPUT", "required": true, "placeholder": "e.g., 2.0" },
