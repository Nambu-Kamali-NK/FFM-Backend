          { "key": "floorNumber", "label": "Floor / Unit Number", "widget": "NUMBER_INPUT", "required": true, "placeholder": "e.g., 4" },
          { "key": "isUnderWarranty", "label": "Equipment Under Manufacturer Warranty?", "widget": "CHECKBOX", "required": false, "defaultValue": false }
        ]
      }
    ]
  },
