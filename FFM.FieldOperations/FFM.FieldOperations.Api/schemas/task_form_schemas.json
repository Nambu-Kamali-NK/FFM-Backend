{
  "GENERAL": {
    "taskType": "GENERAL",
    "formTitle": "Create General Task",
    "description": "Standard work order form for general facility maintenance.",
    "sections": [
      {
        "title": "General Job Details",
        "description": "Basic work order parameters and scheduling",
        "fields": [
          { "key": "title", "label": "Task Title", "widget": "TEXT_INPUT", "required": true, "placeholder": "e.g., Annual Chiller Maintenance" },
          { "key": "clientSiteId", "label": "Client Site Location", "widget": "SEARCHABLE_DROPDOWN", "required": true, "placeholder": "Select client facility" },
          { "key": "priority", "label": "Task Priority", "widget": "DROPDOWN", "required": true, "defaultValue": "MEDIUM", "options": ["LOW", "MEDIUM", "HIGH", "URGENT"] },
          { "key": "scheduledStart", "label": "Scheduled Start Time", "widget": "DATE_TIME_PICKER", "required": true },
          { "key": "scheduledEnd", "label": "Scheduled End Time", "widget": "DATE_TIME_PICKER", "required": true },
          { "key": "assignedEmployeeId", "label": "Assign Field Technician", "widget": "DROPDOWN", "required": false, "placeholder": "Select technician (optional)" },
          { "key": "description", "label": "Work Scope & Instructions", "widget": "TEXT_AREA", "required": false, "placeholder": "Enter detailed scope of work..." }
        ]
      }
    ]
  },
  "AC_MAINTENANCE": {
