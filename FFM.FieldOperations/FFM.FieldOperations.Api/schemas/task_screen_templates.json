{
  "GENERAL": {
    "screenId": "TASK_EXECUTION_SCREEN",
    "title": "General Work Order Execution",
    "version": "2.0",
    "taskType": "GENERAL",
    "theme": {
      "primaryColor": "#1E3A8A",
      "accentColor": "#2563EB",
      "backgroundColor": "#F8FAFC",
      "cardBackgroundColor": "#FFFFFF"
    },
    "widgets": [
      {
        "widgetId": "hero_header",
        "widgetType": "HERO_HEADER",
        "title": "Work Order Overview",
        "order": 1,
        "isVisible": true,
        "properties": {
          "showCountdownTimer": true,
          "badgeStyle": "PILL"
        }
      },
      {
        "widgetId": "client_site_info",
        "widgetType": "CLIENT_SITE_CARD",
        "title": "Client Facility & Geofence",
        "order": 2,
        "isVisible": true,
        "properties": {
          "enableDirectCall": true,
          "enableMapNavigation": true,
          "showGeofenceBoundaryPill": true
        }
      },
      {
        "widgetId": "form_specifications",
        "widgetType": "FORM_SECTION",
        "title": "Job Specifications & Details",
        "order": 3,
        "isVisible": true,
        "properties": {
          "category": "GENERAL"
        }
      },
      {
        "widgetId": "telemetry_readings",
        "widgetType": "TELEMETRY_GAUGES",
        "title": "Operational Telemetry Readings",
        "order": 4,
        "isVisible": true,
        "properties": {
          "metrics": [
            { "key": "statusNotes", "label": "Operational Status", "widget": "TEXT_INPUT", "required": false },
            { "key": "safetyAuditPassed", "label": "Safety Checklist Completed", "widget": "TOGGLE_SWITCH", "required": true }
          ]
        }
      },
      {
        "widgetId": "evidence_gallery",
        "widgetType": "EVIDENCE_GALLERY",
        "title": "Proof of Work (Photos & Signatures)",
        "order": 5,
        "isVisible": true,
        "properties": {
          "allowMultiPhotoUpload": true,
          "checklist": [
            { "evidenceTypeId": 1, "code": "PHOTO", "label": "Before / After Work Photo", "mandatory": true, "maxCount": 5 },
            { "evidenceTypeId": 3, "code": "SIGNATURE", "label": "Customer Sign-Off", "mandatory": false, "maxCount": 1 }
          ]
        }
      },
      {
        "widgetId": "bottom_action_bar",
        "widgetType": "BOTTOM_ACTION_BAR",
        "title": "Execution State Machine Actions",
        "order": 6,
        "isVisible": true,
        "properties": {
          "isSticky": true
        }
      }
    ]
  },
