{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Jwt": {
        "Issuer": "https://ffm.example.com",
        "Audience": "ffm-client",
        "ExpiryMinutes": 60,
        "RefreshExpiryDays": 30,
        "RsaPrivateKey": "<SET_VIA_ENV_VAR_OR_SECRETS_VAULT>"
    },
    "Mfa": {
        "OtpLength": 6,
        "OtpTtlSeconds": 300,
        "MaxInvalidAttempts": 5
    },
    "DeviceBinding": {
        "ClientsRequiringBinding": [
            "ffm-mobile",
            "ffm-pwa"
        ]
    },
    "RateLimit": {
        "MaxFailedAttempts": 5,
        "LockoutMinutes": 15
    },
    "ConnectionStrings": {
        "Postgres": "Host=localhost;Port=5434;Database=ffm_db;Username=ffmid_user;Password=ffm_pass"
    }
}
