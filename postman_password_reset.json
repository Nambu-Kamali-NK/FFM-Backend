{
  "info": {
    "name": "FFM Identity - Password Reset Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Forgot Password (Request Reset)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"seetha@gmail.com\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/auth/forgot-password",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "auth", "forgot-password"]
        }
      }
    },
    {
      "name": "2. Reset Password (Submit Token & New Password)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"<PASTE_TOKEN_FROM_DOCKER_LOGS_OR_EMAIL>\",\n  \"newPassword\": \"SeethaNewPass2026!\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/auth/reset-password",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "auth", "reset-password"]
        }
      }
    },
    {
      "name": "3. Login with New Password",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"seetha@gmail.com\",\n  \"password\": \"SeethaNewPass2026!\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "auth", "login"]
        }
      }
    }
  ]
}
