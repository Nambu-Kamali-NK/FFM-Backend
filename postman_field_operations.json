      "name": "01. Authentication & Token Management",
      "item": [
        {
          "name": "1. Admin Login (Acquire Admin Bearer Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin@ffm.com\",\n  \"password\": \"AdminPassword@123\"\n}"
            },
            "url": {
              "raw": "{{authUrl}}/api/auth/login",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    var token = data.accessToken || data.token || (data.data && data.data.accessToken);",
                  "    if (token) {",
                  "        pm.collectionVariables.set('adminToken', token);",
                  "        console.log('adminToken successfully refreshed.');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
